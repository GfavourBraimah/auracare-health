# AuraCare Health - root environment file for LOCAL docker-compose testing.
#
# Copy this file to `.env` to run `docker compose up` locally.
# NEVER commit the real `.env` file, and NEVER reuse these dummy values
# anywhere outside a local dev machine. In staging/production, every one
# of these values is injected by the deployment platform's secret store
# (AWS Secrets Manager / Parameter Store, ECS task secrets, Kubernetes
# Secrets, etc.) -- never baked into images or compose files.

# --- PostgreSQL (shared local container, one database per service) ---
POSTGRES_USER=auracare_admin
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_PORT=5432

# Logical database names, one per backend service (data isolation between
# services, consistent with the microservices / HIPAA data-boundary model).
PATIENT_DB_NAME=auracare_patients
APPOINTMENT_DB_NAME=auracare_appointments
BILLING_DB_NAME=auracare_billing

# --- Service ports (host-side, for local access only) ---
PATIENT_SERVICE_PORT=8001
APPOINTMENT_SERVICE_PORT=3000
BILLING_SERVICE_PORT=8002
FRONTEND_PORT=80
