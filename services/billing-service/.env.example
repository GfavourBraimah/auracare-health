# AuraCare Health - Billing Service
# Copy to .env for LOCAL DEVELOPMENT ONLY.
# NEVER commit a real .env file or actual credentials to version control.
#
# In staging/production, DATABASE_URL must be injected by the deployment
# platform (ECS task secrets, Kubernetes Secret, AWS Secrets Manager /
# Parameter Store) -- never hardcoded in the image.

# PostgreSQL connection string. The +psycopg2 driver suffix is required:
# SQLAlchemy 2.x resolves a bare "postgresql://" URL to the psycopg (v3)
# dialect, which is NOT installed here (this service uses psycopg2-binary).
# postgresql+psycopg2://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+psycopg2://billing_service_user:changeme@localhost:5432/auracare_billing

# Base URL of the Patient Records Service, used to verify a patient_id
# actually exists before an invoice is created for it (referential
# integrity across services, since each service owns its own database).
PATIENT_SERVICE_URL=http://localhost:8001
