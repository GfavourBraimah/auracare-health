# AuraCare Health - Patient Portal frontend
# Copy to .env for LOCAL DEVELOPMENT ONLY (Vite dev server).
#
# These are build-time variables baked into the static bundle - never put
# secrets here. In this app, the frontend only ever talks to same-origin
# /api/* paths (proxied by nginx/vite), so no backend URLs are needed.
VITE_APP_NAME=AuraCare Health Patient Portal
